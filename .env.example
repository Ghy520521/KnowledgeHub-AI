# ---- App ----
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

# ---- Database (PostgreSQL + pgvector) ----
DATABASE_URL=postgresql+psycopg://knowledgehub:knowledgehub@postgres:5432/knowledgehub

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
# true: 上传后投递 Celery 异步任务；false: 在请求内同步完成解析与向量化
TASK_QUEUE_ENABLED=false

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Embedding 适配器 ----
# provider: openai_compatible | fake（fake 为离线确定性向量，仅用于本地演示与测试）
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Reranker 适配器 ----
# provider: openai_compatible | none | fallback（fallback=词法重叠+向量余弦的本地轻量重排）
RERANKER_PROVIDER=fallback
RERANKER_BASE_URL=https://api.jina.ai/v1
RERANKER_API_KEY=
RERANKER_MODEL=jina-reranker-v2-base-multilingual

# ---- LLM 适配器 ----
# provider: openai_compatible | fake（fake=基于检索片段确定性拼装，离线可演示）
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# ---- 检索参数 ----
VECTOR_TOP_K=20
FTS_TOP_K=20
RRF_K=60
RERANK_TOP_N=10
FINAL_TOP_K=5
# 重排后最高分低于该阈值则判定证据不足并拒答（0~1）
MIN_EVIDENCE_SCORE=0.15

# ---- 分块参数 ----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
